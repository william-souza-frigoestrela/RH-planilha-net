	measure 'Filtro Departamento RLS (Acima 6H)' =
			
			VAR _UsuarioLogado = USERPRINCIPALNAME()
						VAR _UsuarioEstaMapeado =
						    NOT(ISBLANK(CALCULATE(COUNTROWS('dAcessoUsuarios'), ALL('dFilial'), 'dAcessoUsuarios'[EMAIL] = _UsuarioLogado)))
						VAR _FilialDaLinha =
						    SELECTEDVALUE('Planilha NET 24 - Acima de 6 horas sem intervalo'[COLIGADA_FILIAL])
						-- CORRIGIDO: escopado à filial da linha, para não bloquear filiais sem restrição de depto
						VAR _DepartamentosAutorizados =
						    CALCULATETABLE(VALUES('dAcessoUsuarios'[CODDEPARTAMENTO]), ALL('dFilial'), 'dAcessoUsuarios'[EMAIL] = _UsuarioLogado, 'dAcessoUsuarios'[COLIGADA-FILIAL] = _FilialDaLinha)
						VAR _PossuiRestricao =
						    NOT(ISEMPTY(FILTER(_DepartamentosAutorizados, NOT(ISBLANK('dAcessoUsuarios'[CODDEPARTAMENTO])) && 'dAcessoUsuarios'[CODDEPARTAMENTO] <> "")))
						VAR _DeptoDaLinha =
						    SELECTEDVALUE('Planilha NET 24 - Acima de 6 horas sem intervalo'[CODDEPARTAMENTO])
