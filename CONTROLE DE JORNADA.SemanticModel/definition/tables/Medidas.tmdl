	measure 'Filtro RLS Faltas Filial Depto' =
			
			VAR _UsuarioLogado = USERPRINCIPALNAME()
						VAR _UsuarioEstaMapeado =
						    NOT(ISBLANK(CALCULATE(COUNTROWS('dAcessoUsuarios'), ALL('dFilial'), 'dAcessoUsuarios'[EMAIL] = _UsuarioLogado)))
						VAR _FiliaisAutorizadas =
						    CALCULATETABLE(VALUES('dAcessoUsuarios'[COLIGADA-FILIAL]), ALL('dFilial'), 'dAcessoUsuarios'[EMAIL] = _UsuarioLogado)
						VAR _FilialDaLinha = SELECTEDVALUE('Planilha NET 4 – Faltas'[COLIGADA_FILIAL])
						VAR _DeptoDaLinha  = SELECTEDVALUE('Planilha NET 4 – Faltas'[CODDEPARTAMENTO])
						-- CORRIGIDO: departamentos autorizados e a flag de restrição agora são calculados
						-- SOMENTE para a filial da linha atual (_FilialDaLinha), e não para todas as
						-- filiais do usuário juntas. Antes, se QUALQUER filial do usuário tivesse
						-- departamento definido, isso bloqueava as demais filiais que deveriam liberar
						-- todos os departamentos (CODDEPARTAMENTO em branco).
						VAR _DepartamentosAutorizadosNaFilial =
						    CALCULATETABLE(VALUES('dAcessoUsuarios'[CODDEPARTAMENTO]), ALL('dFilial'), 'dAcessoUsuarios'[EMAIL] = _UsuarioLogado, 'dAcessoUsuarios'[COLIGADA-FILIAL] = _FilialDaLinha)
						VAR _PossuiRestricaoDepto =
						    NOT(ISEMPTY(FILTER(_DepartamentosAutorizadosNaFilial, NOT(ISBLANK('dAcessoUsuarios'[CODDEPARTAMENTO])) && 'dAcessoUsuarios'[CODDEPARTAMENTO] <> "")))
						RETURN
						    IF(
						        _UsuarioEstaMapeado = FALSE(), 1,
						        VAR _FilialOk = _FilialDaLinha IN _FiliaisAutorizadas
						        VAR _DeptoOk  = IF(_PossuiRestricaoDepto, _DeptoDaLinha IN _DepartamentosAutorizadosNaFilial, TRUE())
						        RETURN
						            IF(_FilialOk && _DeptoOk, 1, 0)
						    )
		formatString: 0
		lineageTag: 91f14fd4-8c48-47db-93b7-54868c952028

